# 配置项参考；首次运行 deploy-linux.sh 会自动生成 deploy.env，无需手工复制。
DEPLOY_HOST="你的服务器IP"
DEPLOY_PORT="22"
DEPLOY_USER="root"

# 留空则使用系统 SSH 密钥/ssh-agent/交互输入密码。
SSH_IDENTITY_FILE=""
# 需要免交互密码登录时填写；本机需安装 sshpass，密码也可通过环境变量提供。
SSH_PASSWORD="${SSH_PASSWORD:-}"

REMOTE_DIR="/opt/goflylivechat"
HTTP_PORT="8081"
# 默认 http://服务器IP:8081；使用 SSH 别名时请填写真实访问地址。
# HTTPS 需自行配置反向代理和证书。
PUBLIC_URL=""
